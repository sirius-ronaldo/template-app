{
  "name": "empresa/template-app",
  "description": "Template base PHP 8.2 com PDO, HTMX e Tailwind CSS",
  "type": "project",
  "require": {
    "php": "^8.2",
    "nikic/fast-route": "^1.3",
    "psr/log": "^3.0",
    "symfony/yaml": "^7.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0",
    "squizlabs/php_codesniffer": "^3.13.6",
    "robmorgan/phinx": "^0.16"
  },
  "autoload": {
    "psr-4": {"App\\": "app/"}
  },
  "autoload-dev": {
    "psr-4": {"Tests\\": "tests/"}
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse app tests --level=6",
    "check-style": "phpcs --standard=PSR12 app tests",
    "cs": "@check-style",
    "fix-style": "phpcbf --standard=PSR12 app tests",
    "check": ["@cs", "@analyse", "@test"],
    "validate-project": "@check"
  },
  "config": {"sort-packages": true}
}
