APP_ENV=development
APP_DEBUG=true
APP_PORT=8080
APP_TIMEZONE=America/Bahia
LOG_LEVEL=info

# Usadas apenas durante a instalacao inicial; remova-as apos criar o ADMIN.
INITIAL_ADMIN_LOGIN=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

USER_ID=1000
GROUP_ID=1000

DB_HOST=dev-postgres
DB_PORT=5432
DB_DATABASE=template_app
DB_USERNAME=template_app_user
DB_PASSWORD=troque_esta_senha
DB_SCHEMA=public

DB_DATABASE_TEST=template_app_test
DB_USERNAME_TEST=template_app_test_user
DB_PASSWORD_TEST=troque_esta_senha_test

MAIL_HOST=dev-mailpit
MAIL_PORT=1025

XDEBUG_MODE=debug,develop
